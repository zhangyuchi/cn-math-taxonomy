[Unit]
Description=cn-math static server (python http.server)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/cn-math-taxonomy/current
ExecStart=/usr/bin/python3 -m http.server 8000 --bind 127.0.0.1 --directory /srv/cn-math-taxonomy/current
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
